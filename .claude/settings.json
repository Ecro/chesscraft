{
  "hooks": {
    "PostToolUse": [
      {
        "hooks": [
          {
            "command": "uv run --with \"$HOME/.claude/plugins/cache/harness-maker/harness-maker/0.55.0\" python -m harness_maker.telemetry",
            "timeout": 5,
            "type": "command"
          }
        ],
        "matcher": "*"
      },
      {
        "hooks": [
          {
            "command": "uv run --with \"$HOME/.claude/plugins/cache/harness-maker/harness-maker/0.55.0\" python -m harness_maker.hooks.post_write_reminder",
            "timeout": 5,
            "type": "command"
          }
        ],
        "matcher": "Write|Edit|MultiEdit"
      }
    ],
    "PreCompact": [
      {
        "hooks": [
          {
            "command": "uv run --with \"$HOME/.claude/plugins/cache/harness-maker/harness-maker/0.55.0\" python -m harness_maker.hooks.flush_session",
            "statusMessage": "Snapshotting autoloop progress...",
            "timeout": 30,
            "type": "command"
          },
          {
            "command": "uv run --with \"$HOME/.claude/plugins/cache/harness-maker/harness-maker/0.55.0\" python -m harness_maker.worktree span-end",
            "timeout": 10,
            "type": "command"
          }
        ],
        "matcher": "auto"
      },
      {
        "hooks": [
          {
            "command": "uv run --with \"$HOME/.claude/plugins/cache/harness-maker/harness-maker/0.55.0\" python -m harness_maker.hooks.flush_session",
            "statusMessage": "Snapshotting autoloop progress...",
            "timeout": 30,
            "type": "command"
          },
          {
            "command": "uv run --with \"$HOME/.claude/plugins/cache/harness-maker/harness-maker/0.55.0\" python -m harness_maker.worktree span-end",
            "timeout": 10,
            "type": "command"
          }
        ],
        "matcher": "manual"
      }
    ],
    "PreToolUse": [
      {
        "hooks": [
          {
            "command": "uv run --with \"$HOME/.claude/plugins/cache/harness-maker/harness-maker/0.55.0\" python -m harness_maker.gates.permission_gate --subordinate-to-deny-dangerous",
            "timeout": 10,
            "type": "command"
          }
        ],
        "matcher": "Bash"
      },
      {
        "hooks": [
          {
            "command": "uv run --with \"$HOME/.claude/plugins/cache/harness-maker/harness-maker/0.55.0\" python -m harness_maker.gates.worktree_gate",
            "timeout": 10,
            "type": "command"
          }
        ],
        "matcher": "Write|Edit|MultiEdit"
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "command": "uv run --with \"$HOME/.claude/plugins/cache/harness-maker/harness-maker/0.55.0\" python -m harness_maker.hooks.sessionid_envfile",
            "type": "command"
          },
          {
            "command": "uv run --with \"$HOME/.claude/plugins/cache/harness-maker/harness-maker/0.55.0\" python -m harness_maker.hooks.autopilot_autoarm",
            "type": "command"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "command": "uv run --with \"$HOME/.claude/plugins/cache/harness-maker/harness-maker/0.55.0\" python -m harness_maker.hooks.loop_gate --mode stop-hook",
            "timeout": 10,
            "type": "command"
          },
          {
            "command": "uv run --with \"$HOME/.claude/plugins/cache/harness-maker/harness-maker/0.55.0\" python -m harness_maker.worktree span-end",
            "timeout": 10,
            "type": "command"
          }
        ]
      }
    ]
  },
  "permissions": {
    "allow": [
      "Read",
      "Bash(uv run --with $HOME/.claude/plugins/cache/harness-maker/harness-maker/0.55.0 python -m harness_maker.*)",
      "Bash(uv run --with $HOME/.claude/plugins/cache/harness-maker/harness-maker/0.55.0 hm *)",
      "Bash(uv run pytest:*)",
      "Bash(uv run ruff:*)",
      "Bash(uv run mypy:*)",
      "Bash(pytest:*)",
      "Bash(uv run --with $HOME/.claude/plugins/cache/harness-maker/harness-maker/0.55.0 hm second_opinion_invoke:*)",
      "Bash(codex exec:*)",
      "Bash(uv run --with $HOME/.claude/plugins/cache/harness-maker/harness-maker/0.54.1 python -m harness_maker.*)",
      "Bash(uv run --with $HOME/.claude/plugins/cache/harness-maker/harness-maker/0.54.1 hm *)",
      "Bash(uv run --with $HOME/.claude/plugins/cache/harness-maker/harness-maker/0.54.1 hm second_opinion_invoke:*)",
      "Bash(uv run --with $HOME/.claude/plugins/cache/harness-maker/harness-maker/0.54.0 python -m harness_maker.*)",
      "Bash(uv run --with $HOME/.claude/plugins/cache/harness-maker/harness-maker/0.54.0 hm *)",
      "Bash(uv run --with $HOME/.claude/plugins/cache/harness-maker/harness-maker/0.54.0 hm second_opinion_invoke:*)",
      "Bash(uv run --with $HOME/.claude/plugins/cache/harness-maker/harness-maker/0.52.6 python -m harness_maker.*)",
      "Bash(uv run --with $HOME/.claude/plugins/cache/harness-maker/harness-maker/0.52.6 hm *)",
      "Bash(uv run --with $HOME/.claude/plugins/cache/harness-maker/harness-maker/0.52.6 hm second_opinion_invoke:*)",
      "Bash(uv run --with $HOME/.claude/plugins/cache/harness-maker/harness-maker/0.52.5 python -m harness_maker.*)",
      "Bash(uv run --with $HOME/.claude/plugins/cache/harness-maker/harness-maker/0.52.5 hm *)",
      "Bash(uv run --with $HOME/.claude/plugins/cache/harness-maker/harness-maker/0.52.5 hm second_opinion_invoke:*)",
      "Bash(uv run --with $HOME/.claude/plugins/cache/harness-maker/harness-maker/0.52.4 python -m harness_maker.*)",
      "Bash(uv run --with $HOME/.claude/plugins/cache/harness-maker/harness-maker/0.52.4 hm *)",
      "Bash(uv run --with $HOME/.claude/plugins/cache/harness-maker/harness-maker/0.52.4 hm second_opinion_invoke:*)",
      "Bash(uv run --with $HOME/.claude/plugins/cache/harness-maker/harness-maker/0.52.1 python -m harness_maker.*)",
      "Bash(uv run --with $HOME/.claude/plugins/cache/harness-maker/harness-maker/0.52.1 hm *)",
      "Bash(uv run --with $HOME/.claude/plugins/cache/harness-maker/harness-maker/0.52.1 hm second_opinion_invoke:*)",
      "Bash(uv run --with $HOME/.claude/plugins/cache/harness-maker/harness-maker/0.52.0 python -m harness_maker.*)",
      "Bash(uv run --with $HOME/.claude/plugins/cache/harness-maker/harness-maker/0.52.0 hm *)",
      "Bash(uv run --with $HOME/.claude/plugins/cache/harness-maker/harness-maker/0.52.0 hm second_opinion_invoke:*)",
      "Bash(uv run --with $HOME/.claude/plugins/cache/harness-maker/harness-maker/0.51.1 python -m harness_maker.*)",
      "Bash(uv run --with $HOME/.claude/plugins/cache/harness-maker/harness-maker/0.51.1 hm *)",
      "Bash(uv run --with $HOME/.claude/plugins/cache/harness-maker/harness-maker/0.51.1 hm second_opinion_invoke:*)",
      "Bash(uv run --with $HOME/.claude/plugins/cache/harness-maker/harness-maker/0.51.0 python -m harness_maker.*)",
      "Bash(uv run --with $HOME/.claude/plugins/cache/harness-maker/harness-maker/0.51.0 hm *)",
      "Bash(uv run --with $HOME/.claude/plugins/cache/harness-maker/harness-maker/0.51.0 hm second_opinion_invoke:*)",
      "Bash(uv run --with $HOME/.claude/plugins/cache/harness-maker/harness-maker/0.50.1 python -m harness_maker.*)",
      "Bash(uv run --with $HOME/.claude/plugins/cache/harness-maker/harness-maker/0.50.1 hm *)",
      "Bash(uv run --with $HOME/.claude/plugins/cache/harness-maker/harness-maker/0.50.1 hm second_opinion_invoke:*)",
      "Bash(uv run --with $HOME/.claude/plugins/cache/harness-maker/harness-maker/0.49.0 python -m harness_maker.*)",
      "Bash(uv run --with $HOME/.claude/plugins/cache/harness-maker/harness-maker/0.49.0 hm *)",
      "Bash(uv run --with $HOME/.claude/plugins/cache/harness-maker/harness-maker/0.49.0 hm second_opinion_invoke:*)",
      "Bash(uv run --with $HOME/.claude/plugins/cache/harness-maker/harness-maker/0.47.0 python -m harness_maker.*)",
      "Bash(uv run --with $HOME/.claude/plugins/cache/harness-maker/harness-maker/0.47.0 hm *)"
    ],
    "deny": []
  },
  "preset": "Side"
